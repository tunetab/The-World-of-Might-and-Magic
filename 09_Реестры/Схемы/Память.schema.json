{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "type"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string"
    }
  },
  "$defs": {
    "graph_edge": {
      "type": "object",
      "required": ["from", "to", "kind", "evidence", "scope"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"enum": ["participant", "sourced_from", "source_reference", "references"]},
        "evidence": {"type": "string", "minLength": 1},
        "scope": {"enum": ["current", "historical"]}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "knowledge_registry"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "truth",
              "evidence_ids",
              "known_to",
              "visibility"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FACT-[0-9]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "truth": {
                "enum": [
                  "confirmed",
                  "reported",
                  "rumor",
                  "dream",
                  "legend",
                  "inference",
                  "unknown"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "known_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "visibility": {
                "enum": [
                  "public",
                  "restricted",
                  "gm"
                ]
              }
            }
          }
        }
      },
      "required": [
        "facts"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "context_state"
        },
        "chapter_file": {
          "type": "string"
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focus_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "character_id",
              "scene_ids",
              "fact_ids",
              "focus_ids",
              "situation",
              "history"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "character_id": {
                "type": "string"
              },
              "scene_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "focus_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "situation": {
                "type": "string"
              },
              "history": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "chapter_file",
        "scene_ids",
        "fact_ids",
        "focus_ids",
        "branches"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "event_relations"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "relation",
              "evidence_ids",
              "precision"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "relation": {
                "enum": [
                  "after",
                  "overlaps",
                  "learned_after"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "precision": {
                "enum": [
                  "relative",
                  "exact"
                ]
              }
            }
          }
        }
      },
      "required": [
        "relations"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "entity_graph"
        },
        "schema_version": {"const": 3},
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "path",
              "name",
              "source_ids",
              "participant_ids",
              "front_ids",
              "content_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]+-[A-Za-z0-9]+$"
              },
              "path": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "participant_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "front_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/graph_edge"},
              {"properties": {"kind": {"enum": ["participant", "sourced_from", "source_reference"]}}}
            ]
          }
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/graph_edge"},
              {"properties": {"kind": {"const": "references"}}}
            ]
          }
        }
      },
      "required": [
        "entities",
        "edges",
        "references"
      ]
    }
  ]
}
